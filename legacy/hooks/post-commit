#!/bin/bash
# ============================================
# post-commit hook — 放在目標 repo 的 .git/hooks/ 下
# 由 setup.sh 自動安裝,不需要手動複製
#
# 邏輯:只有當這次 commit 有動到 requirements.md,
# 才觸發 pipeline;其他一般開發 commit 不受影響。
# ============================================

REPO_ROOT="$(git rev-parse --show-toplevel)"
PIPELINE_DIR_FILE="$(git rev-parse --git-dir)/.ai-pipeline-dir"

if [ ! -f "$PIPELINE_DIR_FILE" ]; then
  exit 0
fi
PIPELINE_DIR="$(cat "$PIPELINE_DIR_FILE")"

CHANGED_FILES=$(git diff-tree --no-commit-id --name-only -r HEAD)
if ! echo "$CHANGED_FILES" | grep -q "requirements.md"; then
  exit 0
fi

COMMIT_HASH=$(git rev-parse --short HEAD)
REQ_SNAPSHOT="$REPO_ROOT/requirements.md"

echo "🚀 偵測到需求更新 (commit $COMMIT_HASH),背景啟動 pipeline..."

# 背景非同步執行,不卡住你的 commit 動作
nohup "$PIPELINE_DIR/pipeline.sh" "$COMMIT_HASH" "$REQ_SNAPSHOT" \
  > "$PIPELINE_DIR/logs/${COMMIT_HASH}.log" 2>&1 &

disown
echo "   log: $PIPELINE_DIR/logs/${COMMIT_HASH}.log"
